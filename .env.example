# ==============================================================================
# AAROH - Institutional Digital Heritage Archive & AI Platform
# Environment Configuration Template
# ------------------------------------------------------------------------------
# Copy this file to .env or backend/.env and populate with your credentials.
# NEVER commit your actual .env file or sensitive API keys to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cerebras / OpenAI-Compatible LLM Inference Configuration
# ------------------------------------------------------------------------------
# Obtain an API key from https://cloud.cerebras.ai/
LLM_API_KEY=
LLM_BASE_URL=https://api.cerebras.ai/v1
LLM_MODEL=qwen-3.8-27b
EMBEDDING_MODEL=

# ------------------------------------------------------------------------------
# 2. Google Search Grounding (Optional / Fallback)
# ------------------------------------------------------------------------------
# Provides low-latency Gemini grounding when queries expand beyond local corpus.
# Obtain a free key from https://aistudio.google.com/
GOOGLE_API_KEY=
GOOGLE_GROUNDING_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# 3. Archive RAG Confidence & Retrieval Tuning
# ------------------------------------------------------------------------------
# Threshold ratio (0.0 to 1.0) above which local archive evidence is prioritized.
ARCHIVE_CONFIDENCE_THRESHOLD=0.45
ARCHIVE_MIN_TEXT_LENGTH=200

# ------------------------------------------------------------------------------
# 4. Data Root & Server Port
# ------------------------------------------------------------------------------
# Optional path override for external offline archival corpus
AAROH_DATA_ROOT=
PORT=8000
