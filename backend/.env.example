AAROH_DATA_ROOT=D:\\AAROH
LLM_API_KEY=
LLM_BASE_URL=https://api.cerebras.ai/v1
LLM_MODEL=qwen-3.8-27b
EMBEDDING_MODEL=

# --- Google Search Grounding (optional but recommended) ---
# Enables low-latency Gemini-grounded answers with live citations
# when the AAROH local archive lacks sufficient evidence.
# Get a free API key at https://aistudio.google.com
GOOGLE_API_KEY=
GOOGLE_GROUNDING_MODEL=gemini-2.0-flash

# --- Archive confidence tuning ---
# Raise to trust archive more; lower to fall back to Google more.
ARCHIVE_CONFIDENCE_THRESHOLD=0.45
ARCHIVE_MIN_TEXT_LENGTH=200
